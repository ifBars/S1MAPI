  <Project Sdk="Microsoft.NET.Sdk">
   <!-- Import local overrides for contributor paths from repository root -->
    <Import Project="local.build.props" Condition="Exists('local.build.props')" />
 
   <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>S1MAPI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>default</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Configurations>Mono;Il2cpp</Configurations>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PackageId>S1MAPI</PackageId>
    <Title>Schedule 1 Mapping API</Title>
    <Authors>S1MAPI Contributors</Authors>
    <Description>A mapping and construction library for Schedule 1 mods, providing procedural mesh generation, building construction, and GLTF loading while remaining update-resilient.</Description>
    <PackageTags>schedule-1;mapping;modding;il2cpp;mono;procedural-mesh;gltf</PackageTags>
    <RepositoryUrl>https://github.com/ifBars/S1MAPI</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Mono build for base game mono assemblies -->
   <PropertyGroup Condition="'$(Configuration)'=='Mono'">
     <TargetFramework>netstandard2.1</TargetFramework>
     <DefineConstants>MONO</DefineConstants>
     <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Il2Cpp build for MelonLoader net6 assemblies -->
   <PropertyGroup Condition="'$(Configuration)'=='Il2cpp'">
     <TargetFramework>net6.0</TargetFramework>
     <DefineConstants>IL2CPP</DefineConstants>
     <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Mono Unity references -->
  <ItemGroup Condition="'$(Configuration)'=='Mono'">
    <!-- Core Unity Engine -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.dll</HintPath>
    </Reference>

    <!-- Graphics and Rendering -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>

    <!-- UI Systems -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MonoAssembliesPath)\Unity.TextMeshPro.dll</HintPath>
    </Reference>

    <!-- Navigation and AI -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.AIModule.dll</HintPath>
    </Reference>

    <!-- Input Systems -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>

    <!-- Terrain -->
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.TerrainModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TerrainPhysicsModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.TerrainPhysicsModule.dll</HintPath>
    </Reference>

    <!-- JSON Parsing -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MonoAssembliesPath)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- FishNet (Mono) -->
    <Reference Include="FishNet.Runtime">
      <HintPath>$(MonoAssembliesPath)\FishNet.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Il2Cpp Unity references -->
  <ItemGroup Condition="'$(Configuration)'=='Il2cpp'">
    <!-- Core Unity Engine -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.dll</HintPath>
    </Reference>

    <!-- Graphics and Rendering -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>

    <!-- UI Systems -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Il2CppAssembliesPath)\Unity.TextMeshPro.dll</HintPath>
    </Reference>

    <!-- Navigation and AI -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.AIModule.dll</HintPath>
    </Reference>

    <!-- Input Systems -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>

    <!-- Terrain -->
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.TerrainModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TerrainPhysicsModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.TerrainPhysicsModule.dll</HintPath>
    </Reference>

    <!-- JSON Parsing -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(Il2CppAssembliesPath)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- Core IL2CPP Runtime -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppAssembliesPath)\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(Il2CppMLAssembliesPath)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- FishNet (Il2Cpp) -->
    <Reference Include="Il2CppFishNet.Runtime">
      <HintPath>$(Il2CppAssembliesPath)\Il2CppFishNet.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Source Files -->
  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Extensions\**\*.cs" />
    <Compile Include="ProceduralMesh\**\*.cs" />
    <Compile Include="Building\**\*.cs" />
    <Compile Include="Gltf\**\*.cs" />
    <Compile Include="S1\**\*.cs" />
    <Compile Include="Utils\**\*.cs" />
  </ItemGroup>

   <!-- Embedded Resources -->
   <ItemGroup>
     <EmbeddedResource Include="Resources\**\*" />
     <EmbeddedResource Remove="api\**" />
     <EmbeddedResource Remove="_site\**" />
     <EmbeddedResource Remove="Public\**" />
   </ItemGroup>
   <ItemGroup>
     <None Remove="local.build.props.example" />
     <None Remove="AGENTS.md" />
     <None Remove="CODING_STANDARDS.md" />
     <None Remove="api\**" />
     <None Remove="_site\**" />
     <None Remove="Public\**" />
     <None Remove="README_THUNDERSTORE.md" />
     <None Remove="nexuspost.bbcode" />
     <None Include="README.md" Pack="true" PackagePath="\" />
   </ItemGroup>
   <ItemGroup>
     <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
   </ItemGroup>

   <!-- Post-build: Copy to game UserLibs folder -->
   <Target Name="CopyToUserLibs" AfterTargets="Build" Condition="'$(UserLibsPath)'!=''">
     <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UserLibsPath)" />
     <Message Text="Copied $(TargetPath) to $(UserLibsPath)" Importance="high" />
   </Target>

 </Project>
