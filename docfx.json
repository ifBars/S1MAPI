{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "bin/Mono/netstandard2.1",
          "files": [
            "S1MAPI_Mono.dll"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "Nested",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "shouldSkipMarkup": false,
      "force": true,
      "repo": {
        "remote": "https://github.com/ifBars/S1MAPI.git",
        "branch": "stable",
        "path": ""
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "bin/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "files": [
          "styles/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "S1MAPI",
      "_appTitle": "S1MAPI Documentation",
      "_enableSearch": true,
      "_navbarTitle": "S1MAPI",
      "pdf": true,
      "_appFooter": "S1MAPI - Procedural Mesh & Building API for Schedule 1",
      "_enableNewTab": true
    },
    "fileMetadata": {
      "_enableContribution": {
        "api/*.yml": false
      }
    }
  }
}
